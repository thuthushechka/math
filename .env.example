# Local development (SQLite file)
DATABASE_URL="file:./dev.db"

# Production (Turso) — replace with your database URL and auth token
# DATABASE_URL="libsql://your-db-name-org.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# Session secret — generate a random string for production
SESSION_SECRET="change-me-in-production-use-openssl-rand-base64-32"
